[
  {
    "term": "共有参照",
    "code": "&T",
    "avoid": ["不変参照", "不変の参照", "イミュータブル参照"],
    "note": "コンパイラの出力の immutable borrow は、共有参照として借用していることだと説明する"
  },
  {
    "term": "可変参照",
    "code": "&mut T",
    "avoid": ["排他参照", "ミュータブル参照"],
    "note": "「可変参照は同時に 1 つだけ」のように、排他であることは性質として説明する"
  },
  {
    "term": "参照",
    "avoid": [],
    "note": "参照はもの（値と型）を指す。C との対比で C のポインタを指すときは「C のポインタ」と書く"
  },
  {
    "term": "借用",
    "avoid": ["ボロー"],
    "note": "参照を作ることを指す。説明の中で「関数に貸す」のように言い換えてよい"
  },
  {
    "term": "借用チェッカー",
    "avoid": ["ボローチェッカー"]
  },
  {
    "term": "参照外し",
    "code": "*",
    "avoid": ["デリファレンス", "間接参照"]
  },
  {
    "term": "不変の変数",
    "code": "let",
    "avoid": ["イミュータブルな変数"],
    "note": "コンパイラの出力の immutable variable に合わせる。「不変」は変数にだけ使い、参照には使わない"
  },
  {
    "term": "可変の変数",
    "code": "let mut",
    "avoid": ["ミュータブルな変数"]
  },
  {
    "term": "内部可変性",
    "avoid": ["インテリアミュータビリティ"]
  },
  {
    "term": "ダングリング参照",
    "avoid": []
  },
  {
    "term": "所有権",
    "avoid": ["オーナーシップ"]
  },
  {
    "term": "所有者",
    "avoid": ["オーナー"]
  },
  {
    "term": "ムーブ",
    "avoid": ["移動", "譲渡"],
    "note": "「所有権が移る」と言い換えてよい"
  },
  {
    "term": "破棄",
    "avoid": [],
    "note": "値が破棄されること（drop）を指す。drop 関数と Drop トレイトは名前のまま書く"
  },
  {
    "term": "解放",
    "avoid": ["開放"],
    "note": "確保したメモリを返すことを指す"
  },
  {
    "term": "ベクタ",
    "code": "Vec<T>",
    "avoid": ["ベクター", "ベクトル"]
  },
  {
    "term": "イテレータ",
    "avoid": ["イテレーター", "反復子"]
  },
  {
    "term": "クロージャ",
    "avoid": ["クロージャー", "ラムダ"]
  },
  {
    "term": "コンパイラ",
    "avoid": ["コンパイラー"]
  },
  {
    "term": "ポインタ",
    "avoid": ["ポインター"]
  },
  {
    "term": "列挙型",
    "code": "enum",
    "avoid": ["列挙体"]
  },
  {
    "term": "バリアント",
    "avoid": ["列挙子", "ヴァリアント"]
  },
  {
    "term": "構造体",
    "code": "struct",
    "avoid": []
  },
  {
    "term": "フィールド",
    "avoid": ["メンバ", "メンバー"]
  },
  {
    "term": "トレイト",
    "code": "trait",
    "avoid": ["特性"]
  },
  {
    "term": "トレイト境界",
    "avoid": ["トレイト制約"]
  },
  {
    "term": "型パラメータ",
    "avoid": ["型パラメーター", "総称型"]
  },
  {
    "term": "関連関数",
    "avoid": ["静的メソッド"],
    "note": "String::from のように、型に属し、self を取らない関数"
  },
  {
    "term": "ライフタイム",
    "avoid": ["生存期間", "寿命"]
  },
  {
    "term": "ライフタイム注釈",
    "avoid": []
  },
  {
    "term": "型注釈",
    "avoid": ["型アノテーション"]
  },
  {
    "term": "戻り値",
    "avoid": ["返り値", "返却値"]
  },
  {
    "term": "引数",
    "avoid": []
  },
  {
    "term": "パニック",
    "avoid": ["例外"],
    "note": "Rust には例外がない"
  },
  {
    "term": "エラー処理",
    "avoid": ["例外処理"]
  },
  {
    "term": "データ競合",
    "avoid": [],
    "note": "競合状態（race condition）とは別のものとして区別する"
  }
]
