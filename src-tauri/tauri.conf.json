{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Progrust",
  "version": "0.1.0",
  "identifier": "com.progrust.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Progrust",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; worker-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; media-src 'self' asset: data:",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["$RESOURCE/content/lessons/*/video/voice/*.m4a"]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "resources": {
      "gen/bundled/content/": "content/",
      "gen/bundled/runner/": "runner/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}
