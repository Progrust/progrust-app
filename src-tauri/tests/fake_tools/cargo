#!/bin/sh
# テスト用の偽の cargo（spec/non-functional/testing.md「偽の claude と偽の cargo」）。
#
# テストでは、この原本を指すシンボリックリンクを、偽の rustc と同じ一時ディレクトリに置いて
# 使う（tests/fake_tools/mod.rs）。`--version` が返す版は、実行ファイル（リンク）と同じ
# ディレクトリの rust-version に書く。ほかの引数には対応しない。

dir=${0%/*}
if [ "$#" -eq 1 ] && [ "$1" = --version ]; then
  IFS= read -r version < "$dir/rust-version" || [ -n "$version" ] || {
    echo "fake cargo: $dir/rust-version を読めない" >&2
    exit 1
  }
  echo "cargo $version (0123456789 2026-01-01)"
  exit 0
fi
echo "fake cargo: 対応していない引数: $*" >&2
exit 1
