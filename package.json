{
  "name": "progrust",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "~25.9",
    "npm": "~11.12"
  },
  "scripts": {
    "dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "dev:web": "vite",
    "build": "tauri build --bundles app",
    "build:web": "vite build",
    "icon": "rm -rf src-tauri/target/app-icon && tauri icon src-tauri/app-icon.svg -o src-tauri/target/app-icon && cd src-tauri/target/app-icon && cp 32x32.png 128x128.png 128x128@2x.png icon.icns icon.png ../../icons/",
    "lint": "npm run lint:ts && npm run lint:css && npm run lint:rust",
    "lint:ts": "eslint src tools \"*.config.ts\" && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint:css": "stylelint \"{src,tools}/**/*.css\"",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --locked --all-targets -- -D warnings",
    "format": "prettier --write \"{src,tools}/**/*.{ts,tsx,css}\" \"*.config.ts\" && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check \"{src,tools}/**/*.{ts,tsx,css}\" \"*.config.ts\" && cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "test": "vitest run && cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.12.5",
    "react": "~19.3.1",
    "react-dom": "~19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "~2.12.6",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "~10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.10.1",
    "stylelint": "~17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.73.0",
    "vite": "~8.3.8",
    "vitest": "^4.1.12"
  }
}
